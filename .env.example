# Скопируйте этот файл в .env и заполните реальными значениями.
# .env никогда не коммитится в git (см. .gitignore).

# Travelpayouts: бесплатная регистрация на travelpayouts.com,
# токен — в личном кабинете, раздел API. MARKER — тоже из личного кабинета
# (нужен для ссылки на билет, если API не вернёт точную ссылку на тариф).
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# Telegram: бот создаётся через @BotFather (/newbot), токен — из его ответа.
# CHAT_ID — id чата, куда слать алерты (см. README, "Как получить chat_id").
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
